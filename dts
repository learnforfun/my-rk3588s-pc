   &rkcif_mmu {

    	status = "okay";

   };



   &rkisp0 {

    	status = "okay";

   };



   &isp0_mmu {

    	status = "okay";

   };



   &rkisp0_vir2 {

    	status = "okay";



        	port {

                		#address-cells = <1>;

                        		#size-cells = <0>;



                                		isp0_vir2: endpoint@0 {

                                            			reg = <0>;

                                                        			remote-endpoint = <&mipi_lvds2_sditf>;

                                        };

            };

   };
                                                                                                                                                                                                        }
                                                                                                                                                                                        }
        }
